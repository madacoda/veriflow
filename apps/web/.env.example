# Server-only configuration, relative to apps/web.
STORAGE_DIR=../../data
# Shared team login (server only). Copy to .env and provide your own credentials.
AUTH_USERNAME=madacoda
AUTH_PASSWORD=
AUTH_SESSION_SECRET=
# Production behind TLS: AUTH_ORIGIN=https://veriflow.madacoda.dev
# Production cookies are Secure by default. Local HTTP smoke tests only:
# AUTH_COOKIE_SECURE=false
# Draft generation requires a key and explicit model. Restart the server after edits.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Bounded in-process run admission, including queued jobs and cleanup; range 1..8.
VERIFLOW_MAX_CONCURRENT_RUNS=2
# Real headless Chromium is the default. Install it with bun run browsers:install.
# VERIFLOW_RUN_ADAPTER=browser
# Explicit local fixtures only; all such runs are labeled adapter=fake and have no real evidence.
# VERIFLOW_RUN_ADAPTER=fake
# VERIFLOW_FAKE_OUTCOME=failed

