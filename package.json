{
  "name": "veriflow",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --filter \"@veriflow/*\" --if-present build",
    "typecheck": "bun run --filter \"@veriflow/*\" typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:smoke": "bun run --cwd packages/runner test:smoke",
    "browsers:install": "bun run --cwd packages/runner browsers:install",
    "test:unit": "bun run --filter \"@veriflow/*\" --if-present test",
    "start": "bun run --cwd apps/web start"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "bun@1.4.4"
}
